{
  "name": "ai-infra-terminal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "ingest:sec": "tsx --env-file-if-exists=.env.local scripts/ingest-sec.ts",
    "ingest:ir": "tsx --env-file-if-exists=.env.local scripts/ingest-ir.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate-db.ts",
    "db:seed:e2e": "tsx --env-file-if-exists=.env.local scripts/seed-e2e.ts",
    "db:backfill": "tsx --env-file-if-exists=.env.local scripts/backfill-sec-details.ts",
    "db:backfill:ir": "tsx --env-file-if-exists=.env.local scripts/backfill-ir-details.ts",
    "db:process:ir": "tsx --env-file-if-exists=.env.local scripts/process-ir-queue.ts",
    "db:refresh": "tsx --env-file-if-exists=.env.local scripts/backfill-sec-details.ts --force",
    "db:alerts": "tsx --env-file-if-exists=.env.local scripts/generate-alerts.ts",
    "research:cycle": "tsx --env-file-if-exists=.env.local scripts/run-research-cycle.ts",
    "research:cycle:scheduled": "tsx --env-file-if-exists=.env.local scripts/run-scheduled-research-cycle.ts",
    "worker:research": "tsx --env-file-if-exists=.env.local scripts/research-worker.ts",
    "research:briefing": "tsx --env-file-if-exists=.env.local scripts/generate-research-briefing.ts",
    "research:embeddings": "tsx --env-file-if-exists=.env.local scripts/backfill-research-embeddings.ts",
    "research:intelligence": "tsx --env-file-if-exists=.env.local scripts/sync-company-intelligence.ts",
    "research:events": "tsx --env-file-if-exists=.env.local scripts/refresh-live-events.ts",
    "research:evidence": "tsx --env-file-if-exists=.env.local scripts/sync-research-evidence.ts",
    "research:quality": "tsx --env-file-if-exists=.env.local scripts/run-research-quality.ts",
    "research:quality:ai": "tsx --env-file-if-exists=.env.local scripts/run-research-quality.ts --ai",
    "research:metric-quality": "tsx --env-file-if-exists=.env.local scripts/run-metric-quality.ts",
    "research:extraction-quality": "tsx --env-file-if-exists=.env.local scripts/run-extraction-quality.ts",
    "artifacts:backfill": "tsx --env-file-if-exists=.env.local scripts/backfill-source-artifacts.ts",
    "artifacts:verify": "tsx --env-file-if-exists=.env.local scripts/verify-source-artifacts.ts",
    "demo:seed": "tsx --env-file-if-exists=.env.local scripts/seed-portfolio-demo.ts",
    "db:generate": "drizzle-kit generate",
    "db:setup": "pnpm db:migrate && pnpm db:backfill && pnpm db:backfill:ir",
    "test": "pnpm run build && node --test tests/*.test.mjs && tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:integration:pipeline": "tsx --test tests/integration/real-source-pipeline.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern playwright-report --ignore-pattern test-results"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.11",
    "@ai-sdk/react": "4.0.24",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "ai": "^7.0.23",
    "aws4fetch": "^1.0.20",
    "bullmq": "^5.81.2",
    "cheerio": "^1.2.0",
    "cytoscape": "^3.34.0",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.24.0",
    "next": "16.2.6",
    "pg": "^8.22.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "streamdown": "2.5.0",
    "unpdf": "^1.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tsx": "^4.23.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
